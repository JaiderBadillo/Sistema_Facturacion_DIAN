<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/" xmlns:tns="http://uts.edu.co/facturacion"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    name="FacturacionService" targetNamespace="http://uts.edu.co/facturacion">
  <types>
    <xsd:schema targetNamespace="http://uts.edu.co/facturacion" elementFormDefault="qualified">
      <xsd:element name="ConsultarRangosRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="nit" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="ConsultarRangosResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="valido" type="xsd:boolean"/>
            <xsd:element name="mensaje" type="xsd:string"/>
            <xsd:element name="prefijo" type="xsd:string"/>
            <xsd:element name="desde" type="xsd:long"/>
            <xsd:element name="hasta" type="xsd:long"/>
            <xsd:element name="resolucion" type="xsd:string"/>
            <xsd:element name="fechaVigencia" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="EnviarFacturaRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="nitEmisor" type="xsd:string"/>
            <xsd:element name="facturaXml" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="EnviarFacturaResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="estado" type="xsd:string"/>
            <xsd:element name="codigo" type="xsd:string"/>
            <xsd:element name="mensaje" type="xsd:string"/>
            <xsd:element name="codigoSeguridad" type="xsd:string"/>
            <xsd:element name="fechaValidacion" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="ConsultarEstadoRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="numeroFactura" type="xsd:string"/>
            <xsd:element name="nitEmisor" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="ConsultarEstadoResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="existe" type="xsd:boolean"/>
            <xsd:element name="estado" type="xsd:string"/>
            <xsd:element name="numeroFactura" type="xsd:string"/>
            <xsd:element name="totalFactura" type="xsd:float"/>
            <xsd:element name="fechaRegistro" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:schema>
  </types>
  <message name="ConsultarRangosIn"><part name="parameters" element="tns:ConsultarRangosRequest"/></message>
  <message name="ConsultarRangosOut"><part name="parameters" element="tns:ConsultarRangosResponse"/></message>
  <message name="EnviarFacturaIn"><part name="parameters" element="tns:EnviarFacturaRequest"/></message>
  <message name="EnviarFacturaOut"><part name="parameters" element="tns:EnviarFacturaResponse"/></message>
  <message name="ConsultarEstadoIn"><part name="parameters" element="tns:ConsultarEstadoRequest"/></message>
  <message name="ConsultarEstadoOut"><part name="parameters" element="tns:ConsultarEstadoResponse"/></message>
  <portType name="FacturacionPortType">
    <operation name="ConsultarRangosNumeracion">
      <input message="tns:ConsultarRangosIn"/>
      <output message="tns:ConsultarRangosOut"/>
    </operation>
    <operation name="EnviarFactura">
      <input message="tns:EnviarFacturaIn"/>
      <output message="tns:EnviarFacturaOut"/>
    </operation>
    <operation name="ConsultarEstadoFactura">
      <input message="tns:ConsultarEstadoIn"/>
      <output message="tns:ConsultarEstadoOut"/>
    </operation>
  </portType>
  <binding name="FacturacionBinding" type="tns:FacturacionPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="ConsultarRangosNumeracion">
      <soap:operation soapAction="http://uts.edu.co/facturacion/ConsultarRangosNumeracion"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="EnviarFactura">
      <soap:operation soapAction="http://uts.edu.co/facturacion/EnviarFactura"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="ConsultarEstadoFactura">
      <soap:operation soapAction="http://uts.edu.co/facturacion/ConsultarEstadoFactura"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
  </binding>
  <service name="FacturacionService">
    <port name="FacturacionPort" binding="tns:FacturacionBinding">
      <soap:address location="http://localhost:8080/servicio.php"/>
    </port>
  </service>
</definitions>
